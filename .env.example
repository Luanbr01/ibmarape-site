# Copie para .env.local e substitua os valores pelo seu projeto Sanity.
# Projeto / API > Project ID; dataset pode ser production.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# YouTube Data API v3: NÃO use NEXT_PUBLIC_ para a chave.
# ID do canal (começa com UC), obtido em Configurações avançadas do canal YouTube.
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
